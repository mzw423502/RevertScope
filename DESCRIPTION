License_is_FOSS: yes
License_restricts_use: no
URL: https://github.com/mzw423502/RevertScope
BugReports: https://github.com/mzw423502/RevertScope/issues
Encoding: UTF-8
Depends: R (>= 4.6.0)
Imports: limma, edgeR, readxl, yaml, jsonlite, digest
Suggests: renv, shiny, DT, plotly, ggplot2, svglite, systemfonts, ragg,
    processx, ps, fs, zip, htmltools, base64enc
